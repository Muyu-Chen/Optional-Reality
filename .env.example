# Server-side only. Keep separate keys when switching providers.
# compatible uses the original AI_* settings (DeepSeek by default).
AI_PROVIDER=compatible
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=

# DeepSeek supports JSON output. All model operations are also validated by Zod.
AI_RESPONSE_FORMAT=json_object
AI_THINKING=disabled

# Set AI_PROVIDER=gemini and fill this key. The original AI_API_KEY stays saved.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_RESPONSE_FORMAT=json_object
GEMINI_REASONING_EFFORT=minimal

# Optional Gemini -> DeepSeek failover, with independent keys/endpoints.
# Uses AI_* as the backup profile; AI_BASE_URL must be the official DeepSeek URL.
AI_FALLBACK_PROVIDER=none
AI_PRIMARY_TIMEOUT_MS=8000

# Total budget for both provider attempts when fallback is enabled.
AI_TIMEOUT_MS=30000
PORT=3001
# Optional when running behind a reverse proxy:
# APP_ORIGIN=https://your-domain.example

# Optional: use an existing backend from local Vite without copying its provider key.
# npm run dev:web forwards only /api; production builds keep using same-origin /api.
# DEV_API_ORIGIN=https://your-domain.example
